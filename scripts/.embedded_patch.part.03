    '  llamaServer: "http://localhost:8080",\n  embeddedLocal: "embedded://local",\n',
)
replace_once(
    'src/screens/DeviceSettingsScreen.tsx',
    '  llamaServer: "",\n',
    '  llamaServer: "",\n  embeddedLocal: "/absolute/path/to/Qwen3-0.6B-Q4_0.gguf",\n',
)
replace_once(
    'src/screens/DeviceSettingsScreen.tsx',
    '    setSaving(true);\n',
    '    if (selectedProvider === "embeddedLocal" && !model.trim()) {\n      setProviderError("Select an absolute path to a local .gguf model file.");\n      return;\n    }\n    setSaving(true);\n',
)
old_endpoint = '''            <label className="field">
              Endpoint URL{" "}
              <span style={{ fontWeight: 400, opacity: 0.7 }}>(optional)</span>
              <input
                placeholder={DEFAULT_ENDPOINTS[selectedProvider]}
                value={endpointUrl}
                onChange={(e) => setEndpointUrl(e.target.value)}
                aria-label="Endpoint URL"
              />
            </label>
'''
new_endpoint = '''            {selectedProvider !== "embeddedLocal" ? (
              <label className="field">
                Endpoint URL{" "}
                <span style={{ fontWeight: 400, opacity: 0.7 }}>(optional)</span>
                <input
                  placeholder={DEFAULT_ENDPOINTS[selectedProvider]}
                  value={endpointUrl}
                  onChange={(e) => setEndpointUrl(e.target.value)}
                  aria-label="Endpoint URL"
                />
              </label>
            ) : null}
'''
replace_once('src/screens/DeviceSettingsScreen.tsx', old_endpoint, new_endpoint)
replace_once(
    'src/screens/DeviceSettingsScreen.tsx',
    '              Model{" "}\n              <span style={{ fontWeight: 400, opacity: 0.7 }}>(optional)</span>\n',
    '              {selectedProvider === "embeddedLocal" ? "GGUF model path" : "Model"}{" "}\n              <span style={{ fontWeight: 400, opacity: 0.7 }}>\n                ({selectedProvider === "embeddedLocal" ? "required" : "optional"})\n              </span>\n',
)
replace_once(
    'src/screens/DeviceSettingsScreen.tsx',
    '            </label>\n          </div>\n\n          <div className="button-row">\n',
    '            </label>\n            {selectedProvider === "embeddedLocal" ? (\n              <p className="field-hint">\n                The app loads this GGUF directly with llama.cpp. No Ollama,\n                llama-server, API key, or network request is used. Qwen3 0.6B\n                Q4_0 is the recommended starting model.\n              </p>\n            ) : null}\n          </div>\n\n          <div className="button-row">\n',
)
replace_once(
    'src/screens/DeviceSettingsScreen.tsx',
    '                  !hasExistingKeyForProvider)\n',
    '                  !hasExistingKeyForProvider) ||\n                (selectedProvider === "embeddedLocal" && !model.trim())\n',
)
replace_once(
    'src/screens/HostTournamentSetupScreen.tsx',
    '                    Add a Claude API key in settings to use AI profiles.\n',
