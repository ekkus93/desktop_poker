)

# Build dependencies and real-model CI job.
for workflow in ['.github/workflows/ci.yml', '.github/workflows/runtime-full-game-validation.yml']:
    content = read(workflow)
    content = content.replace(
        '            build-essential \\\n            curl \\\n',
        '            build-essential \\\n            clang \\\n            libclang-dev \\\n            cmake \\\n            curl \\\n',
    )
    write(workflow, content)

replace_once(
    '.github/workflows/ci.yml',
    '# Graphical application launch, live LAN play, keychain behavior, and live LLM\n# providers remain separate manual release-readiness gates.\n',
    '# Graphical application launch, live LAN play, keychain behavior, and remote live LLM\n# providers remain separate release-readiness gates. Embedded GGUF inference is tested here.\n',
)
embedded_job = r'''

  embedded-npc:
    name: Embedded tiny-LLM NPC
    runs-on: ubuntu-24.04
    timeout-minutes: 30

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Install embedded inference build dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y build-essential clang libclang-dev cmake curl

      - name: Set up Rust
        uses: dtolnay/rust-toolchain@stable

      - name: Cache Rust dependencies
        uses: swatinem/rust-cache@v2
        with:
          workspaces: . -> target
          key: embedded-npc

      - name: Cache tiny GGUF smoke-test model
        uses: actions/cache@v4
        with:
          path: .cache/embedded-models
          key: smollm2-135m-instruct-q3km-32db44d

      - name: Download tiny GGUF smoke-test model
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p .cache/embedded-models
          model=.cache/embedded-models/SmolLM2-135M-Instruct-Q3_K_M.gguf
          if [[ ! -s "$model" ]]; then
            curl --fail --location --retry 4 --retry-delay 3 \
              -o "$model.tmp" \
              https://huggingface.co/tensorblock/SmolLM2-135M-Instruct-GGUF/resolve/32db44d/SmolLM2-135M-Instruct-Q3_K_M.gguf
            mv "$model.tmp" "$model"
          fi
          test -s "$model"
          ls -lh "$model"
          sha256sum "$model" | tee embedded-model.sha256

      - name: Run real embedded-model NPC decision
        env:
          DESKTOP_POKER_REQUIRE_EMBEDDED_MODEL: "1"
          DESKTOP_POKER_EMBEDDED_TEST_MODEL: .cache/embedded-models/SmolLM2-135M-Instruct-Q3_K_M.gguf
        run: |
          cargo test -p desktop-poker --test embedded_npc_smoke -- --nocapture \
            2>&1 | tee embedded-npc-smoke.log

      - name: Upload embedded NPC evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: embedded-tiny-llm-npc-evidence
          path: |
            embedded-model.sha256
            embedded-npc-smoke.log
